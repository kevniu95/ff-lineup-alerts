{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Spike: ESPN decision rules",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/spike_decision_rules_espn.py",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Spike: Sleeper decision rules",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/spike_decision_rules_sleeper.py",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Spike: ESPN write path",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/spike_espn_write.py",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Poller (--test=check)",
            "type": "debugpy",
            "request": "launch",
            "module": "ff_lineup_alerts.poller",
            "args": ["--test=check"],
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}

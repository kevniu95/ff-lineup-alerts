# Copy to .env and fill in real values. Never commit .env itself (it's
# gitignored) -- this template is the only version meant to be checked in.

# LLM API keys (scripts/spike_llm_*.py connectivity spikes; not yet used by
# the poller itself). Get from platform.openai.com / console.anthropic.com.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Sleeper league config. League ID is the numeric id in your league's Sleeper
# URL; username is your own Sleeper username (used to find your roster within
# the league, since Sleeper doesn't have a separate numeric team id).
SLEEPER_LEAGUE_ID=""
SLEEPER_USERNAME=""

# ESPN league config. league_id/SWID/espn_s2 come from your browser's cookies
# on fantasy.espn.com while logged in (Application/Storage > Cookies in
# devtools) -- SWID and espn_s2 authenticate as you, so treat them as secrets.
# ESPN_TEAM_ID is your own team's numeric id within the league.
ESPN_LEAGUE_ID=""
ESPN_SWID=""
ESPN_S2=""
ESPN_TEAM_ID=""
# ESPN_YEAR="2026"  # optional -- defaults to 2026 in espn_client.py if unset

# Telegram bot config. BOT_API_TOKEN comes from @BotFather when you create the
# bot; TELEGRAM_CHAT_ID is your own chat id with that bot (send it a message,
# then hit https://api.telegram.org/bot<token>/getUpdates to find the id).
BOT_API_TOKEN=""
TELEGRAM_CHAT_ID=""

# Railway sets this automatically once a Volume is attached to the poller
# service -- do not set manually; sleeper_client.py falls back to a local
# data/cache/ dir when it's unset. See docs/scope.md's open questions.
# RAILWAY_VOLUME_MOUNT_PATH=
